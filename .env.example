# ---------------------------------------------------------------------------
# Intensify Technologies — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Optional: URL of a backend endpoint that accepts POSTed contact-form JSON.
# When set, the contact form submits a JSON payload here and reports the real
# server response (success/error).
#
# When NOT set, the form falls back to opening the visitor's email client with
# the enquiry pre-filled (it never fakes a "sent" confirmation).
#
# Expected request:  POST <endpoint>
# Content-Type:      application/json
# Body: { name, email, company, phone, subject, message }
# Expected success:  HTTP 2xx
#
# VITE_CONTACT_ENDPOINT=https://api.intensify.co.in/contact
